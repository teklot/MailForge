<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>MailForge.Abstractions</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>MailForge abstractions define the provider-agnostic programming model for the MailForge transactional communication ecosystem: IEmailProvider, IEmailSender, EmailMessage, delivery status, and capability contracts shared across every layer.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>MailForge.Abstractions</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>MailForge;Email;TransactionalEmail;SMTP;Abstractions;Provider;dotnet-library</PackageTags>
    <PackageReleaseNotes>Phase 0 repository and CI/CD scaffolding for the MailForge ecosystem. This package defines the shared abstraction contracts consumed by MailForge.Core and all provider packages.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/mailforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/mailforge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
