<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>MailForge.Webhook</Title>
    <Description>MailForge.Webhook is a channel and provider adapter for the MailForge transactional communication ecosystem. Delivers MailForge notifications as HTTP POST requests to any webhook endpoint.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>MailForge.Webhook</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>MailForge;Webhook;Notifications;Http;Provider;API;dotnet-library</PackageTags>
    <PackageReleaseNotes>Webhook channel delivering notifications as HTTP POST requests with custom auth headers and HMAC-SHA256 request signing.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/mailforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/mailforge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailForge\MailForge.csproj" />
    <ProjectReference Include="..\MailForge.Communication\MailForge.Communication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.13" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
