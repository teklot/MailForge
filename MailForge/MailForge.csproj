<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>MailForge</Title>
    <Description>MailForge is the core of the MailForge transactional communication ecosystem. Provides the provider-agnostic contracts (IEmailProvider, IEmailSender, EmailMessage, delivery status) and the developer programming model: typed emails, Razor and inline template rendering, auto plain-text generation, validation, middleware pipeline, FakeEmailProvider, and services.AddMailForge(...) DI integration.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>MailForge</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>MailForge;Email;TransactionalEmail;SMTP;Framework;Core;Abstractions;Pipeline;Validation;dotnet-library</PackageTags>
    <PackageReleaseNotes>Typed Email&lt;TModel&gt;, Razor and inline template rendering, auto plain-text generation, middleware pipeline (logging, retries, auditing), validation, FakeEmailProvider, and services.AddMailForge(...) DI integration.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/mailforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/mailforge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="RazorEngineCore" Version="2026.1.1" />
  </ItemGroup>

</Project>
