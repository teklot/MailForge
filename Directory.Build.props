<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.2.0</Version>
    <Authors>TekLot</Authors>
  </PropertyGroup>

  <!--
    Transitive dependency override: MimeKit/MailKit reference a vulnerable
    System.Security.Cryptography.Pkcs (8.0.x/10.0.0); this pins the patched
    10.0.13 for our build. Remove once MimeKit/MailKit ship a patched
    dependency of their own. PrivateAssets="all" keeps it out of published
    package metadata.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <InternalsVisibleTo Include="MailForge.Tests" />
  </ItemGroup>
</Project>
