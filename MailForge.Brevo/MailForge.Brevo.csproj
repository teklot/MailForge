<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>MailForge.Brevo</Title>
    <Description>MailForge.Brevo is a provider adapter for the MailForge transactional communication ecosystem. Delivers MailForge messages through the Brevo (formerly Sendinblue) email API.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>MailForge.Brevo</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>MailForge;Email;TransactionalEmail;Brevo;Sendinblue;Provider;API;dotnet-library</PackageTags>
    <PackageReleaseNotes>Brevo (Sendinblue) API provider adapter supporting HTML/text, attachments, headers, and tags.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/mailforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/mailforge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailForge\MailForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.10" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
