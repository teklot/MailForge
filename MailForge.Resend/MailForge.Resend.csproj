<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>MailForge.Resend</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>MailForge.Resend is a provider adapter for the MailForge transactional communication ecosystem. Delivers MailForge messages through the Resend email API.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>MailForge.Resend</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>MailForge;Email;TransactionalEmail;Resend;Provider;API;dotnet-library</PackageTags>
    <PackageReleaseNotes>Phase 1 framework MVP: Resend API provider adapter supporting HTML/text, attachments, custom headers, and tags.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/mailforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/mailforge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailForge.Abstractions\MailForge.Abstractions.csproj" />
    <ProjectReference Include="..\MailForge.Core\MailForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.10" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
